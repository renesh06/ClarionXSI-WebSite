{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clarionxsi-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "PROJECT_NAME": "ClarionX Super Intelligence",
    "VERSION": "1.0.0",
    "ENVIRONMENT": "production"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clarionxsi-website-db",
      "database_id": "76e2014d-5b03-4fba-bf92-28c02e30d84d"
    }
  ]
}
